{
  "@context": {
    "@version": 1.1,

    "vemcert": "https://w3id.org/vemcert/v1#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "_comment": "Terms minted in the Vemcert namespace. Person-level properties (holderName, dateOfBirth, placeOfBirth) are NOT here: they map to schema.org in the per-schema ld_context, which is correct and stays that way.",

    "awardDate": "vemcert:awardDate",
    "certificateNumber": "vemcert:certificateNumber",
    "certificationTitle": "vemcert:certificationTitle",
    "expiryDate": "vemcert:expiryDate",
    "level": "vemcert:level",
    "mention": "vemcert:mention",
    "programme": "vemcert:programme",
    "session": "vemcert:session",
    "specialization": "vemcert:specialization",
    "studentNumber": "vemcert:studentNumber",

    "AttendanceEvidence": "vemcert:AttendanceEvidence",
    "LegacyMigration": "vemcert:LegacyMigration",
    "basis": "vemcert:basis",
    "sourceRef": "vemcert:sourceRef",
    "computedBy": { "@id": "vemcert:computedBy", "@type": "@id" },
    "hoursAttended": { "@id": "vemcert:hoursAttended", "@type": "xsd:decimal" },
    "recordedAt": { "@id": "vemcert:recordedAt", "@type": "xsd:dateTime" },
    "formulaVersion": { "@id": "vemcert:formulaVersion", "@type": "xsd:integer" },

    "participationKind": "vemcert:participationKind",
    "activityName": "vemcert:activityName",
    "unitName": "vemcert:unitName",
    "participationDetail": "vemcert:participationDetail",
    "personRef": "vemcert:personRef",

    "courseTitle": "vemcert:courseTitle",
    "completionDate": "vemcert:completionDate",
    "score": "vemcert:score",
    "tutorName": "vemcert:tutorName",
    "durationHours": "vemcert:durationHours",
    "trackingId": "vemcert:trackingId",
    "outcome": "vemcert:outcome",
    "outcomeText": "vemcert:outcomeText",
    "decidedOn": { "@id": "vemcert:decidedOn", "@type": "xsd:date" },
    "documentSha256": "vemcert:documentSha256",
    "courseCode": "vemcert:courseCode",
    "periodName": "vemcert:periodName",
    "lecturerName": "vemcert:lecturerName",
    "topics": { "@id": "vemcert:topics", "@type": "xsd:integer" },
    "declaredPercent": { "@id": "vemcert:declaredPercent", "@type": "xsd:integer" },
    "verifiedPercent": { "@id": "vemcert:verifiedPercent", "@type": "xsd:integer" },
    "closedOn": { "@id": "vemcert:closedOn", "@type": "xsd:date" },
    "registrationNumber": "vemcert:registrationNumber",
    "clearance": "vemcert:clearance",
    "offices": { "@id": "vemcert:offices", "@container": "@list" },
    "clearedOn": { "@id": "vemcert:clearedOn", "@type": "xsd:date" },
    "verificationKind": "vemcert:verificationKind",
    "verifiedClaim": "vemcert:verifiedClaim",
    "requestedBy": "vemcert:requestedBy",
    "verifiedOn": { "@id": "vemcert:verifiedOn", "@type": "xsd:date" }
  }
}
